# The API key lives in this file. Never commit it.
# config/ai.example.php IS committed: it is the template to copy.
config/ai.php
config/mail.php

# Uploaded learner material and extracted text.
storage/uploads/*
!storage/uploads/.gitkeep
storage/backups/

# Profile pictures. Participant photographs, so this is a privacy line and not
# a tidiness one: without it a `git add -A` publishes a real person's face to a
# public repository, and git history makes that hard to take back. Found on
# 18 November 2026 with one real photo already sitting untracked.
#
# No .gitkeep needed; avatar_store() in includes/avatar.php creates the
# directory on first upload.
storage/avatars/

# The manuscript. Large, not source code, and Chapter IV may carry participant
# data. The landing page content taken from it lives in includes/manuscript.php,
# which IS committed; that file is the interface between the two.
docs/*.docx
docs/*.pdf

# Where Patrick drops source assets before they are processed into the site.
# It currently holds a 16 MB copy of the explainer video; the copy the page
# actually serves is assets/video/eduflex-explainer.mp4, which IS committed.
# Without this line a `git add -A` puts both in the repository and doubles it.
Claude outputs/

# Composer's vendor directory, AT THE PROJECT ROOT ONLY.
#
# The leading slash matters. Written as "vendor/" this pattern also matches
# assets/vendor/, which holds Bootstrap, jQuery and the Inter font. Those are
# vendored deliberately so the system makes no external network request and
# renders identically in a room with no wifi. They MUST be committed, or a
# fresh clone has an unstyled interface and no working JavaScript.
/vendor/
composer.lock

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Python cache from build_pages.py and the browser tests.
__pycache__/
*.pyc

# Android build outputs. The project under android/ IS committed; what Gradle
# produces from it is not.
#
# local.properties is the important one: Android Studio writes the absolute
# path of the SDK on whichever machine opened the project, so committing it
# gives every teammate a path that does not exist on their laptop. Android
# Studio recreates it on first open.
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/captures/

# The built APK lands in android/app/build/, which the line above covers. To
# hand the team a copy, attach it to a GitHub release or send the file; do not
# commit a binary that changes on every build.

# Delivery archives. The repository is the source of truth, not a zip.
*.zip
