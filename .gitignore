# The API key lives in this file. Never commit it.
# config/ai.example.php IS committed: it is the template to copy.
config/ai.php
config/mail.php

# Uploaded learner material and extracted text.
storage/uploads/*
!storage/uploads/.gitkeep
storage/backups/

# The manuscript. Large, not source code, and Chapter IV may carry participant
# data. The landing page content taken from it lives in includes/manuscript.php,
# which IS committed; that file is the interface between the two.
docs/*.docx
docs/*.pdf

# Where Patrick drops source assets before they are processed into the site.
# It currently holds a 16 MB copy of the explainer video; the copy the page
# actually serves is assets/video/eduflex-explainer.mp4, which IS committed.
# Without this line a `git add -A` puts both in the repository and doubles it.
Claude outputs/

# Composer's vendor directory, AT THE PROJECT ROOT ONLY.
#
# The leading slash matters. Written as "vendor/" this pattern also matches
# assets/vendor/, which holds Bootstrap, jQuery and the Inter font. Those are
# vendored deliberately so the system makes no external network request and
# renders identically in a room with no wifi. They MUST be committed, or a
# fresh clone has an unstyled interface and no working JavaScript.
/vendor/
composer.lock

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Python cache from build_pages.py and the browser tests.
__pycache__/
*.pyc

# Delivery archives. The repository is the source of truth, not a zip.
*.zip
