<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0 and newer. The launcher masks this to whatever shape the
     device uses, which is why the background is a flat colour and all the
     detail sits well inside the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ef_ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
